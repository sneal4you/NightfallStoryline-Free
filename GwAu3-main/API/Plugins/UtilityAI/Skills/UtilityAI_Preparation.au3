#include-once
Func Anti_Preparation()
	Return False
EndFunc
Func CanUse_MelandrusArrows()
	If Anti_Preparation() Then Return False
	Return True
EndFunc
Func BestTarget_MelandrusArrows($a_f_AggroRange)
	Return UAI_GetPlayerInfo($GC_UAI_AGENT_ID)
EndFunc
