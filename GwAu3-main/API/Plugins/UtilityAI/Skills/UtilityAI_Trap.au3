#include-once
Func Anti_Trap()
	Return False
EndFunc
Func CanUse_DustTrap()
	If Anti_Trap() Then Return False
	Return True
EndFunc
Func BestTarget_DustTrap($a_f_AggroRange)
	Return UAI_GetPlayerInfo($GC_UAI_AGENT_ID)
EndFunc
